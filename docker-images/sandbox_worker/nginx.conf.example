# 安装到专用执行主机的 Nginx；先替换域名、证书路径和业务后端出口 IP。
# 192.0.2.1 为文档占位地址，默认不能承接真实业务请求。
server {
    listen 443 ssl;
    server_name sandbox.example.invalid;
    ssl_certificate /etc/jianzi-worker/tls/fullchain.pem;
    ssl_certificate_key /etc/jianzi-worker/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow 192.0.2.1;
    deny all;
    client_max_body_size 200000;
    client_body_timeout 5s;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:8093;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Task-Owner $http_x_task_owner;
        proxy_connect_timeout 3s;
        proxy_read_timeout 120s;
        proxy_send_timeout 10s;
        proxy_buffering off;
    }
}
