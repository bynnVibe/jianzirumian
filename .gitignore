# ---- 敏感配置（绝不入库）----
.env
*.env
!.env.example
!*/.env.example

# ---- 运行时数据（含用户数据/向量库/上传图片）----
data/
backend/uploads/

# ---- 运行日志 ----
backend/log/
.dev-logs/
deploy-all.log
*.log

# ---- AI 助手本地记忆（个人工作记录，不入库）----
.workbuddy/

# ---- 个人分析文档（仅保留架构图 docs/architecture.html）----
docs/*
!docs/architecture.html

# ---- 本地手工测试素材 ----
test_files/

# ---- IDE 本地缓存 ----
.qoder/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ---- Node ----
node_modules/
frontend/dist/

# ---- 构建/部署产物 ----
*.tar.gz
docker-images/*.tar.gz

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
