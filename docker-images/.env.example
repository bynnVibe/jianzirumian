# ============================================
# 见字如面 - 环境变量配置
# ============================================
# 复制此文件为 .env 后再修改

# ---- 服务器 ----
HOST=0.0.0.0
PORT=8000
# 生产环境保持 false；本地调试需要详细日志时改为 true
DEBUG=false

# ---- LLM 配置 ----
# provider: "ollama" | "openai" | "custom"
LLM_PROVIDER=ollama

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI 兼容 API（通义千问 / DeepSeek / OpenAI 等）
API_BASE_URL=https://api.deepseek.com/v1
API_KEY=sk-your-api-key-here
API_MODEL=deepseek-chat

# ---- Embedding 配置 ----
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small

# ---- OCR 配置 ----
# provider: "local" | "aliyun" | "custom_api"
OCR_PROVIDER=local

# 阿里云 OCR
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr.cn-shanghai.aliyuncs.com

# 自定义远程 OCR API
CUSTOM_OCR_API_URL=
CUSTOM_OCR_API_KEY=

# PaddleOCR 本地配置
PADDLE_OCR_LANG=ch
PADDLE_OCR_USE_GPU=false

# ---- 向量存储 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=3

# ---- Rerank 重排序 ----
# provider: "local" (本地 CrossEncoder 模型) | "dashscope" (阿里云 DashScope API)
# 注：若后端镜像以瘦身模式构建（SLIM=1，部署脚本默认开启），
# 镜像内无 torch / sentence-transformers，此处必须使用 dashscope 等远端提供商，
# 否则重排序不可用（仅日志告警，不影响检索主流程）
RERANKER_PROVIDER=local
# 本地模型（首次运行自动下载 ~2.2GB）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 阿里云 DashScope OpenAI 兼容 rerank 接口（base_url 为 .../compatible-api/v1，请求路径 /reranks）
# API Key 获取: https://bailian.console.aliyun.com/?apiKey=1；未配置时回退到 DASHSCOPE_API_KEY
DASHSCOPE_RERANK_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-api/v1
DASHSCOPE_RERANK_API_KEY=
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# ---- 联网搜索 ----
# provider: "duckduckgo" | "bing" | "serpapi" | "anysearch"
SEARCH_PROVIDER=duckduckgo
BING_API_KEY=
SERPAPI_API_KEY=
# AnySearch 统一搜索（Key 可选，留空则匿名访问，限额较低）。注册: https://anysearch.com/console/api-keys
ANYSEARCH_API_KEY=

# ---- 跨域（CORS）----
# 逗号分隔，允许这些来源跨域访问后端 API
# 部署到服务器时，加上服务器的 IP 或域名，如: http://123.45.67.89:5173,https://your-domain.com
CORS_ORIGINS=

# ---- 会话 ----
SESSION_MAX_HISTORY=20
# 登录态有效期（秒），滑动续期，默认 24 小时
SESSION_DURATION=86400

# ---- Redis 文件缓存 ----
# 缓存知识检索/知识库跳转的原始文件（图片/Word/PDF），加速跳转与预览；
# 公共知识库文件全局共享缓存，个人知识库文件按属主隔离；
# Redis 不可用时自动降级直读磁盘（功能不受影响）。
# Docker 部署时 compose 默认注入 redis://redis:6379/0，本地开发需自行启动 Redis
REDIS_URL=redis://localhost:6379/0
# 关闭文件缓存设为 false
FILE_CACHE_ENABLED=true
# 缓存过期时间（秒），默认 24 小时
FILE_CACHE_TTL=86400
# 单文件缓存大小上限（MB），超限不缓存
FILE_CACHE_MAX_MB=20

# ---- llm-wiki 知识编译层 ----
# 借鉴 llm-wiki（LLM 作为知识编译器）：资料入库后台自动提炼成结构化百科卡片写入向量库，
# 问答检索优先命中预编译知识；也可在系统设置页/接口手动生成跨素材综合报告（digest）。
# 可在「系统设置」页面在线开关（页面配置优先于此值）。
WIKI_COMPILE_ENABLED=true
# 参与编译的单资料最大字符数（超出截断，控制 LLM 输入成本）
WIKI_MAX_SOURCE_CHARS=6000
# 低于该字符数的资料不编译
WIKI_MIN_SOURCE_CHARS=80
# 相邻两次编译 LLM 请求的最小间隔秒数（存量补编译时缓解免费模型限流）
WIKI_COMPILE_INTERVAL=3
