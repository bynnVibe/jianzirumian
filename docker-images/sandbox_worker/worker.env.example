# 专用 Linux 执行主机的非 root 账户使用；不放业务数据、凭据或 Docker socket。
# 本文件不包含密钥。共享令牌文件至少 32 个随机 ASCII 字符，权限 0600。
SANDBOX_WORKER_TOKEN_FILE=/home/sandbox/.config/jianzi-worker/token
SANDBOX_WORKER_STATE=/home/sandbox/.local/state/jianzi-worker
SANDBOX_PODMAN=/usr/bin/podman
# 必须设置最终任务镜像的 registry/repository@sha256:digest，并提前离线加载。
SANDBOX_PYTHON_IMAGE=
# 只有专用 Linux 主机真实隔离验收通过后，管理员才可改为 true。
SANDBOX_ISOLATION_ACCEPTED=false
