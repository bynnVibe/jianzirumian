# ============================================
# 见字如养 - 环境变量配置
# ============================================
# 复制此文件为 .env 后再修改

# ---- 服务器 ----
HOST=0.0.0.0
PORT=8000
# 生产环境保持 false；本地调试需要详细日志时改为 true
DEBUG=false

# ---- LLM 配置 ----
# provider: "ollama" | "openai" | "custom"
LLM_PROVIDER=ollama

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI 兼容 API（通义千问 / DeepSeek / OpenAI 等）
API_BASE_URL=https://api.deepseek.com/v1
API_KEY=sk-your-api-key-here
API_MODEL=deepseek-chat

# ---- Embedding 配置 ----
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small

# ---- OCR 配置 ----
# provider: "local" | "aliyun" | "custom_api"
OCR_PROVIDER=local

# 阿里云 OCR
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr.cn-shanghai.aliyuncs.com

# 自定义远程 OCR API
CUSTOM_OCR_API_URL=
CUSTOM_OCR_API_KEY=

# PaddleOCR 本地配置
PADDLE_OCR_LANG=ch
PADDLE_OCR_USE_GPU=false

# ---- 向量存储 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=3

# ---- Rerank 重排序 ----
# provider: "local" (本地 CrossEncoder 模型) | "dashscope" (阿里云 DashScope API)
RERANKER_PROVIDER=local
# 本地模型（首次运行自动下载 ~2.2GB）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 阿里云 DashScope OpenAI 兼容 rerank 接口（base_url 为 .../compatible-api/v1，请求路径 /reranks）
# API Key 获取: https://bailian.console.aliyun.com/?apiKey=1；未配置时回退到 DASHSCOPE_API_KEY
DASHSCOPE_RERANK_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-api/v1
DASHSCOPE_RERANK_API_KEY=
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# ---- 联网搜索 ----
# provider: "duckduckgo" | "bing" | "serpapi" | "anysearch"
SEARCH_PROVIDER=duckduckgo
BING_API_KEY=
SERPAPI_API_KEY=
# AnySearch 统一搜索（Key 可选，留空则匿名访问，限额较低）。注册: https://anysearch.com/console/api-keys
ANYSEARCH_API_KEY=

# ---- 跨域（CORS）----
# 逗号分隔，允许这些来源跨域访问后端 API
# 部署到服务器时，加上服务器的 IP 或域名，如: http://123.45.67.89:5173,https://your-domain.com
CORS_ORIGINS=

# ---- 会话 ----
SESSION_MAX_HISTORY=20
# 登录态有效期（秒），滑动续期，默认 24 小时
SESSION_DURATION=86400
